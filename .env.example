# Copy to .env and fill in. The app runs file-based (CSV/GeoJSON) without a database;
# DATABASE_URL is only needed once PostGIS is enabled.

# PostgreSQL + PostGIS (optional, via docker-compose)
DATABASE_URL="postgresql://lehrp:lehrp@localhost:5432/lehrp?schema=public"

# MapLibre basemap style (open-source; no paid key required)
NEXT_PUBLIC_MAP_STYLE="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"

# Default map view (Ladera Ranch approx center)
NEXT_PUBLIC_MAP_CENTER_LAT="33.5467"
NEXT_PUBLIC_MAP_CENTER_LNG="-117.6403"
NEXT_PUBLIC_MAP_ZOOM="12"

# US Census API key (optional; increases rate limits). https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=""
