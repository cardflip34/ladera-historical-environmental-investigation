// LEHRP Prisma schema. PostGIS-ready; the platform also runs file-based (CSV/GeoJSON)
// without a database. Geometry is stored as GeoJSON text until PostGIS is enabled.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReliabilityGrade {
  A1
  A2
  B1
  B2
  C
  D
}

enum MedicalVerificationStatus {
  not_independently_verified
  registry_confirmed
  official_confirmed
}

enum EvidenceClass {
  documented_exact
  documented_within_reporting_unit
  documented_purchase
  documented_approved_product
  contractually_permitted
  current_policy_product
  historically_likely
  industry_standard_inference
  unverified_allegation
}

enum DevelopmentStatementClass {
  documented_exact
  documented_approximate
  corroborated_secondary
  visual_interpretation
  estimate
  unresolved
}

enum TemporalPrecision {
  day
  month
  year
  range
  unknown
}

enum ResearchStatus {
  open
  in_progress
  blocked
  resolved
}

model Source {
  id                String            @id
  title             String
  publisher         String?
  author            String?
  url               String?
  publicationDate   DateTime?
  retrievalDate     DateTime          @default(now())
  sourceType        String
  geographicCoverage String?
  timeCoverage      String?
  isOfficial        Boolean           @default(false)
  isPrimary         Boolean           @default(false)
  isPeerReviewed    Boolean           @default(false)
  dataFormat        String?
  localFilePath     String?
  checksum          String?
  citationText      String?
  reliabilityGrade  ReliabilityGrade
  knownLimitations  String?
  notes             String?

  healthEvents      PublicHealthEvent[]
  literature        LiteratureEntry[]
  products          PesticideProduct[]
  ingredients       ActiveIngredient[]
  applications      ApplicationEvent[]
  applicationAreas  ApplicationArea[]
  sites             Site[]
  environmentalSites EnvironmentalSite[]
  waterSystems      WaterSystem[]
  developmentEvents DevelopmentEvent[]
  developmentSnapshots AnnualDevelopmentSnapshot[]
  developmentSchools SchoolDevelopmentRecord[]
  developmentNeighborhoods NeighborhoodDevelopmentRecord[]
  developmentImagery HistoricalImageryRecord[]
  developmentPlanningAreas PlanningAreaRecord[]
  developmentObligations DevelopmentObligation[]
  developmentQuestions DevelopmentResearchQuestion[]
}

model PublicHealthEvent {
  id                          String   @id
  reportedDiagnosis           String
  isEwingSarcoma              Boolean  @default(false)
  approximateAge              String?
  approximateYearOfDiagnosis  String?
  communityAssociation        String?
  sourceId                    String
  source                      Source   @relation(fields: [sourceId], references: [id])
  sourceWording               String?
  namesIndividual             Boolean  @default(false)
  hasCorroboration            Boolean  @default(false)
  medicalVerificationStatus   MedicalVerificationStatus @default(not_independently_verified)
  duplicateResolutionStatus   String   @default("unique")
  notes                       String?
}

model LiteratureEntry {
  id                String  @id
  citation          String
  doi               String?
  pmid              String?
  abstract          String?
  studyDesign       String?
  population        String?
  sampleSize        String?
  exposure          String?
  outcome           String?
  effectEstimate    String?
  confidenceInterval String?
  mainFinding       String?
  limitations       String?
  funding           String?
  conflicts         String?
  relevanceToProject String?
  evidenceDirection String?
  sourceId          String?
  source            Source? @relation(fields: [sourceId], references: [id])
}

model PesticideProduct {
  id                    String    @id
  productName           String
  manufacturer          String?
  epaRegistrationNumber String?
  caRegistrationId      String?
  formulation           String?
  registrationStatus    String?
  firstRegistrationDate DateTime?
  cancellationDate      DateTime?
  sourceId              String?
  source                Source?   @relation(fields: [sourceId], references: [id])
}

model ActiveIngredient {
  id                              String  @id
  commonName                      String
  casNumber                       String?
  chemicalClass                   String?
  soilHalfLife                    String?
  waterHalfLife                   String?
  vaporPressure                   String?
  solubility                      String?
  koc                             String?
  driftPotential                  String?
  runoffPotential                 String?
  cancerClassification            String?
  developmentalToxicityClassification String?
  genotoxicityEvidence            String?
  endocrineActivityEvidence       String?
  restrictedMaterialCA            Boolean @default(false)
  sourceId                        String?
  source                          Source? @relation(fields: [sourceId], references: [id])
}

model ApplicationEvent {
  id                 String        @id
  date               DateTime?
  time               String?
  temporalPrecision  String?
  productId          String?
  activeIngredientId String?
  quantity           Float?
  unit               String?
  applicationRate    String?
  area               String?
  cropOrSiteType     String?
  location           String?
  locationPrecision  String?
  applicator         String?
  permitNumber       String?
  method             String?
  targetPest         String?
  weatherNotes       String?
  evidenceClass      EvidenceClass @default(unverified_allegation)
  confidenceGrade    ReliabilityGrade?
  sourceId           String?
  source             Source?       @relation(fields: [sourceId], references: [id])
  notes              String?
}

model ApplicationArea {
  id                String  @id
  geometry          String? // GeoJSON text
  accuracy          String?
  reportingUnit     String?
  parcelId          String?
  siteName          String?
  siteType          String?
  bufferAssumptions String?
  sourceId          String?
  source            Source? @relation(fields: [sourceId], references: [id])
}

model Site {
  id                       String  @id
  name                     String
  address                  String?
  coordinates              String? // "lat,lng" or GeoJSON point text
  operator                 String?
  owner                    String?
  maintenanceResponsibility String?
  knownVendor              String?
  knownProduct             String?
  knownApplication         String?
  policyDocuments          String?
  sourceQuality            String?
  earliestEvidence         String?
  latestEvidence           String?
  unknownFields            String?
  sourceId                 String?
  source                   Source? @relation(fields: [sourceId], references: [id])
}

model EnvironmentalSite {
  id             String  @id
  name           String
  siteType       String?
  status         String?
  contaminants   String?
  geometry       String? // GeoJSON text
  database       String?
  distanceToZoneA String?
  sourceId       String?
  source         Source? @relation(fields: [sourceId], references: [id])
}

model WaterSystem {
  id                  String  @id
  name                String
  provider            String?
  source              String?
  treatmentType       String?
  serviceAreaGeometry String? // GeoJSON text
  sourceId            String?
  sourceRel           Source? @relation(fields: [sourceId], references: [id])
}

model DevelopmentEvent {
  id                   String                    @id
  title                String
  eventType            String
  dateStart            DateTime
  dateEnd              DateTime?
  temporalPrecision    TemporalPrecision
  placeName            String?
  featureId            String?
  status               String?
  statementClass       DevelopmentStatementClass
  confidence           String
  sourceLocator        String?
  interpretationMethod String?
  conflictNotes        String?
  notes                String?
  geometry             String?                   // GeoJSON text
  geometryPrecision    String?
  sources              Source[]
}

model AnnualDevelopmentSnapshot {
  year                       Int      @id
  communityStatus            String
  tractMapsRecordedByYear    Int
  tractMapsRecordedCumulative Int
  homesSoldAsOf              Int?
  activeSchoolCount          Int
  documentedMilestones       String
  ranchlandStatus            String?
  gradingStatus              String?
  roadStatus                 String?
  utilityStatus              String?
  confidence                 String
  limitations                String
  geometry                   String?  // GeoJSON text; current CDP display extent unless documented otherwise
  sources                    Source[]
}

model SchoolDevelopmentRecord {
  id                String    @id
  name              String
  openDate          DateTime
  planningStart     DateTime?
  constructionStart DateTime?
  constructionEnd   DateTime?
  geometry          String?   // GeoJSON point text
  geometryPrecision String?
  statementClass    DevelopmentStatementClass
  confidence        String
  limitations       String?
  sources           Source[]
}

model NeighborhoodDevelopmentRecord {
  id                   String  @id
  name                 String
  planningArea         String?
  firstGradingDate     DateTime?
  firstConstructionDate DateTime?
  firstSaleDate        DateTime?
  firstOccupancyDate   DateTime?
  substantialBuildout  DateTime?
  geometry             String? // GeoJSON text
  geometryPrecision    String?
  confidence           String
  limitations          String
  sources              Source[]
}

model HistoricalImageryRecord {
  id                String    @id
  captureDateStart  DateTime?
  captureDateEnd    DateTime?
  displayYear       Int
  coverage          String?
  localFilePath     String?
  checksum          String?
  registration      String?
  interpretationStatus String?
  limitations       String
  sources           Source[]
}

model PlanningAreaRecord {
  id                   String  @id
  planningArea         String
  landUse              String
  maxDwellingUnits     Int?
  residentialNetAcres  Float?
  grossAcres           Float?
  geometry              String? // GeoJSON text
  geometryPrecision     String?
  confidence            String
  limitations           String
  sources               Source[]
}

model DevelopmentObligation {
  id             String                    @id
  triggerType    String
  triggerValue   String?
  obligation     String
  status         String
  sourceLocator  String?
  statementClass DevelopmentStatementClass
  confidence     String
  limitations    String
  sources        Source[]
}

model DevelopmentResearchQuestion {
  id            String         @id
  priority      String
  category      String
  question      String
  evidenceNeeded String
  status        ResearchStatus
  blockedOutput String?
  nextAction    String?
  sources       Source[]
}

model HistoricalObservationRecord {
  id                  String   @id
  observedEntityId    String
  observationType     String
  observedValue       String
  exactDate           DateTime?
  earliestDate        DateTime?
  latestDate          DateTime?
  temporalPrecision   TemporalPrecision
  temporalBasis       String?
  geometryId          String?
  geometryType        String?
  geometryStatus      String?
  evidenceId          String?
  pageOrFrameReference String?
  observationMethod   String
  researcherOrAgent   String?
  directOrInferred    String
  confidence          String
  confidenceRationale String?
  limitations         String
  createdAt           DateTime @default(now())
  recordVersion       String
  supersedesId        String?
  reviewStatus        String
  sourceIds           String
}

model DevelopmentClaimRecord {
  id                       String   @id
  subjectEntityId          String
  claimType                String
  claimText                String
  earliestDate             DateTime?
  latestDate               DateTime?
  temporalPrecision        TemporalPrecision
  claimScope               String
  supportingObservationIds String
  counterEvidenceIds       String?
  sourceIds                String
  supportType              String
  statementClass           DevelopmentStatementClass
  confidence               String
  confidenceRationale      String?
  conflictStatus           String
  reviewStatus             String
  limitations              String
  recordVersion            String
}

model DevelopmentLifecycleInterval {
  id                 String   @id
  entityId           String
  stateDimension     String
  stateValue         String
  validFrom          DateTime?
  validTo            DateTime?
  startBoundType     String?
  endBoundType       String?
  temporalPrecision  TemporalPrecision
  geometryId         String?
  geometryStatus     String
  sourceIds          String
  supportingClaimIds String
  statementClass     DevelopmentStatementClass
  confidence         String
  proximityEligible  Boolean  @default(false)
  limitations        String
  recordVersion      String
}

model ConstructionActivityRecord {
  id                       String   @id
  activityClass            String
  canonicalName            String
  relatedTractIds          String?
  relatedNeighborhoodIds   String?
  relatedPlanningAreaIds   String?
  relatedBuilderIds        String?
  geometry                 String?
  geometryMethod           String
  geometrySource           String?
  earliestStart            DateTime?
  latestStart              DateTime?
  earliestEnd              DateTime?
  latestEnd                DateTime?
  temporalPrecision        TemporalPrecision
  lifecycleState           String
  intensityClass           String
  evidenceIds              String
  sourceIds                String
  confidence               String
  confidenceRationale      String
  limitations              String
  reviewStatus             String
  recordVersion            String
  proximityEligible        Boolean  @default(false)
}

model OccupancyEventRecord {
  id                  String   @id
  relatedEventId      String?
  geographyId         String
  geographyType       String
  eventClass           String
  eventTitle           String
  earliestDate         DateTime
  latestDate           DateTime
  temporalPrecision    TemporalPrecision
  homeCount            Int?
  habitabilityConclusion String
  occupancyConclusion  String
  geometry              String?
  geometryStatus       String
  sourceIds             String
  statementClass       DevelopmentStatementClass
  confidence            String
  confidenceRationale   String
  limitations           String
  reviewStatus          String
  proximityEligible     Boolean  @default(false)
}

model EvidenceGraphEdgeRecord {
  id             String   @id
  fromId         String
  fromType       String
  relationship   String
  toId           String
  toType         String
  validFrom      DateTime?
  validTo        DateTime?
  evidenceIds    String
  sourceIds      String
  confidence     String
  recordVersion  String
  reviewStatus   String
  limitations    String?
  notes          String?

  @@index([fromId])
  @@index([toId])
  @@index([relationship])
}

model DevelopmentConflictRecord {
  id                  String @id
  subjectId           String
  conflictType        String
  positionA           String
  positionAEvidenceIds String
  positionASourceIds  String
  positionB           String
  positionBEvidenceIds String
  positionBSourceIds  String
  resolution          String
  confidence          String
  reviewStatus        String
}

model DevelopmentResearchGapRecord {
  id                    String @id
  topic                 String
  scope                 String
  evidenceNeeded        String
  recommendedRepository String
  searchOrAccessStatus  String
  priority              String
  analyticalImpact      String
  recommendedFollowUp   String
  reviewStatus          String
}
